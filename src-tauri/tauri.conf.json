{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ITSM Manager",
  "version": "0.1.7",
  "identifier": "com.sie.itsm-manager",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ITSM 管理工具",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4MEYxMDhBQzUwQkZEMjMKUldRai9RdkZpaEFQU0R0amZLblpSTDRpMm1EL1pXWFpzSlpzYnFueVdKU3l5azBzVEdxTCtzUWwK",
      "endpoints": [
        "https://github.com/SIE-Operations-and-Maintenance-Team/ITSM-Manager/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
