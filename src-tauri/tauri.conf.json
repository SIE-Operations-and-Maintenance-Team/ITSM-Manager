{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ITSM Manager",
  "version": "0.1.0",
  "identifier": "com.sie.itsm-manager",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ITSM 管理工具",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
